# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_TIMEOUT_SECONDS=60

# Hosted Qdrant (HTTPS)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documind_documents

# Docker PostgreSQL. Leave DATABASE_URL blank to derive it from these values.
# Example override: postgresql+psycopg://documind_user:<url-encoded-password>@postgres:5432/documind
POSTGRES_DB=documind
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
EMBEDDING_CACHE_TTL_SECONDS=3600

# Models and retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Required for custom model IDs. The built-in models have pinned revisions.
EMBEDDING_REVISION=
RERANKER_REVISION=
EMBEDDING_BATCH_SIZE=32
RERANK_ENABLED=true
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
DENSE_MIN_SCORE=0.35

# Application
APP_NAME=DocuMind AI
APP_ENV=development
DEBUG=false
SECRET_KEY=
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=8
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CORS_ORIGINS=[]
LOG_LEVEL=INFO

# Frontend and host ports
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=8501
